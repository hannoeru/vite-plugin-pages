{
  "name": "vite-plugin-pages",
  "type": "module",
  "version": "1.0.0-beta.1",
  "packageManager": "pnpm@12.5.1",
  "description": "File system base vue-router plugin for Vite",
  "author": "hannoeru <me@hanlee.co>",
  "license": "MIT",
  "homepage": "https://github.com/hannoeru/vite-plugin-pages",
  "repository": {
    "type": "git",
    "url": "https://github.com/hannoeru/vite-plugin-pages"
  },
  "bugs": "https://github.com/hannoeru/vite-plugin-pages/issues",
  "keywords": [
    "vite",
    "vue",
    "vue-router",
    "react",
    "react-router",
    "solid-js",
    "@solidjs/router",
    "file-system-based",
    "routing"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./client-react": {
      "types": "./client-react.d.ts"
    },
    "./client-solid": {
      "types": "./client-solid.d.ts"
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "LICENSE",
    "client-react.d.ts",
    "client-solid.d.ts",
    "client.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build -- --watch --ignore-watch examples",
    "build": "tsdown",
    "play": "pnpm --filter vue dev",
    "play:react": "pnpm --filter react dev",
    "prepublishOnly": "npm run build",
    "release": "bumpp --commit --tag --push",
    "publish:ci": "tsx scripts/publish.ts",
    "test": "vitest",
    "test:e2e": "vitest -c vitest.config.e2e.ts",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^2.7.0 || ^3.0.0",
    "vite": "^6.0.0-0 || ^7.0.0-0 || ^8.0.0-0"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3",
    "dequal": "^2.0.3",
    "extract-comments": "^1.1.0",
    "json5": "^2.2.3",
    "local-pkg": "^1.2.1",
    "micromatch": "^4.0.8",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/utils": "^9.3.0",
    "@solidjs/router": "^1.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.2",
    "@vitest/ui": "^5.0.2",
    "@vue/compiler-sfc": "^3.5.43",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-router": "^8.4.0",
    "solid-js": "^1.9.15",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
